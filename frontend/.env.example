# Local development needs no settings: `npm start` serves the app on :3000 and the
# "proxy" in package.json forwards /api calls to the backend on http://localhost:5253.
#
# On Vercel set these (Project -> Settings -> Environment Variables):
#   REACT_APP_API_BASE=/api      calls go through the rewrite in vercel.json
#   CI=false                     so lint warnings don't fail the build

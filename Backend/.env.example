# Copy this file to .env (same folder) for running the backend locally.
# On Render, add the same names under Environment instead. Never commit the real .env.

# Supabase → Connect → Session pooler (Npgsql / .NET format)
ConnectionStrings__ArtifaxDatabase=Host=aws-0-eu-central-1.pooler.supabase.com;Port=5432;Database=postgres;Username=postgres.YOUR_PROJECT_REF;Password=YOUR_DB_PASSWORD;SSL Mode=Require;Trust Server Certificate=true

# Supabase → Project Settings → API (used to email the 6-digit login code)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_OR_PUBLISHABLE_KEY

# Your Vercel site (comma-separate several). Only needed if the frontend calls Render directly.
FRONTEND_URL=https://your-app.vercel.app

# Accounts that skip the emailed code (portfolio demo login)
TWO_FACTOR_BYPASS_EMAILS=demo@artifax.app,cpt@artifax.app
